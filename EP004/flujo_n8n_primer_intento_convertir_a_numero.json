    {
      "parameters": {
        "jsCode": "// Primer intento (A): «convertir a número» como se hace a menudo: cambiar la coma por punto y parseFloat.\nconst num = (s) => { const n = parseFloat(String(s ?? '').replace(',', '.')); return Number.isFinite(n) ? n : 0; };\nconst filas = $input.all().map((it) => it.json);\nconst out = filas.map((r) => ({ json: { fecha: r.fecha, codigo: Number(r.codigo), producto: r.producto, cliente: r.cliente, unidades: num(r.unidades), precio_unitario: num(r.precio_unitario), descuento_pct: num(String(r.descuento_pct ?? '').replace('%', '')), importe: num(r.importe) } }));\nconst total = Math.round(out.reduce((s, it) => s + it.json.importe, 0) * 100) / 100;\nreturn [...out, { json: { fecha: 'TOTAL', codigo: '', producto: '', cliente: '', unidades: '', precio_unitario: '', descuento_pct: '', importe: total } }];"
      },
