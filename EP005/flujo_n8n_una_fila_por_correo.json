      "id": "c5000001-0000-4000-8000-000000000007",
      "name": "Unir los dos listados",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Segundo intento (B): la clave es el correo normalizado (sin espacios, en minúsculas). Un correo = una persona.\n// Si la misma persona trae datos distintos en los dos listados, no se adivina: se marca para revisar.\nconst limpio = (s) => String(s ?? '').replace(/\\s+/g, ' ').trim();\nconst clave = (s) => String(s ?? '').trim().toLowerCase();\nconst filas = $input.all().map((it) => it.json);\nconst porClave = new Map();\nfor (const r of filas) {\n  const k = clave(r.email);\n  const fila = { nombre: limpio(r.nombre), apellidos: limpio(r.apellidos), email: k, telefono: limpio(r.telefono), ciudad: limpio(r.ciudad) };\n  if (!porClave.has(k)) { porClave.set(k, { ...fila, estado: 'ok', aviso: '', repeticiones: 1 }); continue; }\n  const p = porClave.get(k);\n  p.repeticiones += 1;\n  const avisos = [];\n  if (p.telefono !== fila.telefono) avisos.push('teléfono distinto en los dos listados (' + p.telefono + ' · ' + fila.telefono + ')');\n  if (p.ciudad !== fila.ciudad) avisos.push('ciudad distinta (' + p.ciudad + ' · ' + fila.ciudad + ')');\n  if (avisos.length > 0) { p.estado = 'revisar'; p.aviso = [p.aviso, ...avisos].filter(Boolean).join('; '); }\n}\nconst out = [...porClave.values()].map((p) => ({ json: p }));\nconst n = out.length, rev = out.filter((it) => it.json.estado === 'revisar').length;\nreturn [...out, { json: { nombre: 'RESUMEN', apellidos: 'filas leídas: ' + filas.length + ' · personas: ' + n + ' · repetidas quitadas: ' + (filas.length - n) + ' · ok: ' + (n - rev) + ' · revisar: ' + rev, email: '', telefono: '', ciudad: '', estado: '', aviso: 'una fila por correo normalizado; conflictos marcados, no adivinados', repeticiones: null } }];"
      },
      "id": "c5000001-0000-4000-8000-000000000006",
      "name": "Una fila por correo",
