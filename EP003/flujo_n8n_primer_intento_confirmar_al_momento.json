    {
      "parameters": {
        "jsCode": "// Primer intento (A): cada envío va a la hoja tal cual, con lo que diga el servidor de correo.\nconst envios = $('Dividir en envíos').all().map((it) => it.json);\nconst salidas = $input.all().map((it) => it.json);\nreturn envios.map((r, i) => { const out = salidas[i] ?? {}; return { json: { id: r.id, recibido: r.recibido, nombre: r.nombre, email: r.email, asunto: r.asunto, estado: 'confirmada', correo: out.error ? 'error: ' + String(out.error.message ?? out.error).slice(0, 80) : 'enviado' } }; });"
