    {
      "parameters": {
        "jsCode": "// Segundo intento (B1): comprobar antes de anotar. No se envía ningún correo aquí.\nconst norm = (s) => (s ?? '').toString().trim().toLowerCase().replace(/\\s+/g, ' ');\nconst emailOk = (e) => /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(e);\nconst lista = (x) => (Array.isArray(x) ? x : []); // con la hoja vacía, Extract From File devuelve {} y no []\nconst envios = lista($('Extraer envíos').first().json.data);\nconst hoja = lista($('Extraer hoja').first().json.data).map((r) => ({ ...r }));\nconst ahora = new Date().toISOString();\nconst clave = (r) => norm(r.email) + '|' + norm(r.asunto);\nconst registradas = new Map(hoja.filter((r) => r.estado === 'registrada').map((r) => [clave(r), r.id]));\nfor (const e of envios) {\n  const fila = { id: e.id, recibido: e.recibido, nombre: (e.nombre ?? '').trim(), email: (e.email ?? '').trim(), asunto: (e.asunto ?? '').trim(), mensaje: e.mensaje ?? '', estado: null, motivo: null, duplicado_de: null, correo_enviado: false, enviado_en: null, registrado_en: ahora };\n  const faltan = [];\n  if (!fila.email) faltan.push('correo'); else if (!emailOk(fila.email)) faltan.push('correo con formato inválido');\n  if (!fila.asunto) faltan.push('asunto');\n  if (!fila.nombre) faltan.push('nombre');\n  if (faltan.length) { fila.estado = 'rechazada'; fila.motivo = 'Falta o es inválido: ' + faltan.join(', ') + '. No se envía correo.'; hoja.push(fila); continue; }\n  const k = clave(fila);\n  if (registradas.has(k)) { fila.estado = 'duplicada'; fila.duplicado_de = registradas.get(k); fila.motivo = 'Mismo correo y misma solicitud que ' + fila.duplicado_de + ': no se registra otra vez ni se envía otro correo.'; hoja.push(fila); continue; }\n  fila.estado = 'registrada'; fila.motivo = 'Datos completos; primera vez que llega esta solicitud. Pendiente de aprobación para enviar la confirmación.';\n  registradas.set(k, fila.id); hoja.push(fila);\n}\nreturn hoja.map((r) => ({ json: r }));"
      },
