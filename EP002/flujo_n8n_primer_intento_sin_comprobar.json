      "id": "b2000000-0000-4000-8000-000000000003",
      "name": "Extraer texto del PDF",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Primer intento (A): sacar los importes del texto con expresiones regulares, sin comprobar nada.\nconst num = (s) => { if (s == null) return null; const n = Number(s.replace(/\\./g, '').replace(',', '.')); return Number.isFinite(n) ? n : null; };\nconst out = [];\nfor (const item of $input.all()) {\n  const t = item.json.text || '';\n  const numero = (t.match(/N[ºo°]\\s*(\\d{4}\\/\\d{3})/) || [])[1] || null;\n  const f = t.match(/Fecha:\\s*(\\d{2})\\/(\\d{2})\\/(\\d{4})/);\n  const fecha = f ? f[3] + '-' + f[2] + '-' + f[1] : null;\n  const lines = t.split('\\n').map((l) => l.trim()).filter(Boolean);\n  const iNif = lines.findIndex((l) => /^NIF\\s+[A-Z]\\d{8}$/.test(l) && !/B99999999/.test(l));\n  const proveedor = iNif > 0 ? lines[iNif - 1] : null;\n  const base = num((t.match(/(?:Base imponible|Importe neto)\\s*([\\d.,]+)\\s*€/) || [])[1]);\n  const iva = num((t.match(/(?:IVA\\s*\\(\\d+\\s*%\\)|Cuota IVA\\s*\\d+%)\\s*([\\d.,]+)\\s*€/) || [])[1]);\n  const total = num((t.match(/(?:TOTAL|Importe total)\\s*([\\d.,]+)\\s*€/) || [])[1]);\n  out.push({ json: { archivo: item.json.fileName, base, iva, total, numero, fecha, proveedor, estado: 'procesada' } });\n}\nreturn out;"
      },
      "id": "b2000000-0000-4000-8000-000000000004",
