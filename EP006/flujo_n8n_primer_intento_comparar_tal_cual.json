    {
      "parameters": {
        "jsCode": "// Etiqueta la rama del nodo Compare Datasets para poder contarla.\nreturn $input.all().map((it) => { const j = it.json; const codigo = j.keys ? j.keys.codigo : j.codigo; const campos = j.different ? Object.keys(j.different).join(', ') : ''; return { json: { resultado: 'solo_en_enero', codigo, producto: j.producto ?? (j.same ? j.same.producto : ''), campos } }; });"
